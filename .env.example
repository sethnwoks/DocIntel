# OpenAI API key (required for embeddings + LLM)
OPENAI_API_KEY=

# JWT secret (required for auth).
# The app refuses to start without this - there is deliberately no default,
# because a committed fallback secret lets anyone forge a token for any tenant.
# Generate your own:  openssl rand -hex 32
JWT_SECRET_KEY=

# Optional: set to 'production' for HTTPS-only cookies
# ENV=production
