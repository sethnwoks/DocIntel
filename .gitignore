# Scripts - ignore loose scratch files, but keep the schema, the migrations
# and the terminal client (the README tells people to run scripts/rag_cli).
scripts/*
!scripts/schema.sql
!scripts/migration_parsed_documents.sql
!scripts/migration_bm25.sql
!scripts/rag_cli/

# NOTE: backend/tests/ is deliberately NOT ignored. The test suite is part of
# the showcase, and its current state is documented honestly in the README.

# Frontend build artifacts
frontend/.next/
frontend/node_modules/
frontend/tsconfig.tsbuildinfo

# ONNX reranker weights -- too large for GitHub (model.onnx ~280MB,
# tokenizer.json ~17MB). Both must be fetched together; shipping one without
# the other is useless. See "Reranker weights" in the README.
backend/models/reranker/model.onnx
backend/models/reranker/tokenizer.json

# Another agent tool's scratch worktrees (contain a nested .git)
.kilo/

# Database dumps. backups/rag_db_*.sql contains real account emails and bcrypt
# password hashes from local testing -- never commit this.
backups/
*.sql.gz

